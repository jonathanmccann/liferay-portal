<%@ include file="/html/portlet/directory/user/search_columns_user_name.jspf" %>

<liferay-ui:search-container-column-text
	href="<%= rowURL %>"
	name="screen-name"
	orderable="<%= true %>"
	property="screenName"
/>

<liferay-ui:search-container-column-text
	href="<%= rowURL %>"
	name="job-title"
	orderable="<%= true %>"
	value="<%= user2.getJobTitle() %>"
/>

<liferay-ui:search-container-column-text
	buffer="buffer"
	href="<%= rowURL %>"
	name="organizations"
>

	<%
	List<Organization> curOrganizations = OrganizationLocalServiceUtil.getUserOrganizations(user2.getUserId(), 0, SearchContainer.DEFAULT_DELTA + 1);

	for (int i = 0; i < curOrganizations.size() && i < SearchContainer.DEFAULT_DELTA; i++) {
		Organization curOrganization = curOrganizations.get(i);

		buffer.append(HtmlUtil.escape(curOrganization.getName()));
		buffer.append(StringPool.COMMA_AND_SPACE);
	}

	if (!curOrganizations.isEmpty()) {
		buffer.setIndex(buffer.index() - 1);
	}

	if (curOrganizations.size() > SearchContainer.DEFAULT_DELTA) {
		buffer.append(StringPool.TRIPLE_PERIOD);
	}
	%>

</liferay-ui:search-container-column-text>

<liferay-ui:search-container-column-text
	buffer="buffer"
	href="<%= rowURL %>"
	name="user-groups"
>

	<%
	List<UserGroup> curUserGroups = UserGroupLocalServiceUtil.getUserUserGroups(user2.getUserId(), 0, SearchContainer.DEFAULT_DELTA + 1);

	for (int i = 0; i < curUserGroups.size() && i < SearchContainer.DEFAULT_DELTA; i++) {
		UserGroup curUserGroup = curUserGroups.get(i);

		buffer.append(HtmlUtil.escape(curUserGroup.getName()));
		buffer.append(StringPool.COMMA_AND_SPACE);
	}

	if (!curUserGroups.isEmpty()) {
		buffer.setIndex(buffer.index() - 1);
	}

	if (curUserGroups.size() > SearchContainer.DEFAULT_DELTA) {
		buffer.append(StringPool.TRIPLE_PERIOD);
	}
	%>

</liferay-ui:search-container-column-text>